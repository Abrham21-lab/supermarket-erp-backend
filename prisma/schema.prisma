generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id       Int        @id @default(autoincrement())
  name     String?    @unique @db.VarChar(100)
  products products[]
}

model products {

  id             Int @id @default(autoincrement())


  category_id    Int?

  supplier_id    Int?

  unit_id        Int?

  branch_id      Int?


  name           String?

  barcode        String?


  purchase_price Decimal?

  selling_price Decimal?


  quantity       Int? @default(0)


  created_at DateTime? @default(now())



  categories categories?
  @relation(
    fields:[category_id],
    references:[id]
  )


  supplier suppliers?
  @relation(
    fields:[supplier_id],
    references:[id]
  )


  unit units?
  @relation(
    fields:[unit_id],
    references:[id]
  )


  branch branches?
  @relation(
    fields:[branch_id],
    references:[id]
  )

}

model User {
  id          Int @id @default(autoincrement())

  username    String

  email       String @unique

  password    String

  tenantId    Int?

  tenant      Tenant? @relation(
                    fields:[tenantId],
                    references:[id]
                )
}

model Tenant {
  id            Int      @id @default(autoincrement())

  name          String

  logo          String?

  contactEmail  String?

  phone         String?

  address       String?

  status        Boolean  @default(true)

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  users         User[]
}

model inventory_transactions {


id Int @id @default(autoincrement())


product_id Int


branch_id Int


transaction_type String


quantity Int


reference String?


created_at DateTime @default(now())



products products @relation(
fields:[product_id],
references:[id]
)



branches branches @relation(
fields:[branch_id],
references:[id]
)


}
